{
  "name": "upgradian",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":          "turbo run dev",
    "build":        "turbo run build",
    "lint":         "turbo run lint",
    "type-check":   "turbo run type-check",
    "dev:web":      "turbo run dev --filter=@upgradian/web",
    "dev:mobile":   "turbo run dev --filter=@upgradian/mobile",
    "dev:api":      "turbo run dev --filter=@upgradian/api",
    "build:web":    "turbo run build --filter=@upgradian/web",
    "build:desktop":"turbo run build --filter=@upgradian/desktop",
    "db:migrate":   "supabase db push",
    "db:seed":      "supabase db reset",
    "db:types":     "supabase gen types typescript --local > packages/types/src/supabase.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
